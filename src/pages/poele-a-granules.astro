---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FeatureCard from '../components/FeatureCard.astro';
import RealisationsGrid from '../components/RealisationsGrid.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import RelatedTools from '../components/RelatedTools.astro';
import ServiceArea from '../components/ServiceArea.astro';
import Icon from '../components/Icon.astro';
import { byCategory } from '../data/realisations';
import { faqSchema, serviceSchema, type Faq as FaqItem } from '../lib/schema';
import hero from '../assets/images/realisations/poele-granules-palazzetti-anna-pro-3.jpg';
import detail from '../assets/images/produits/poele-granules-detail.jpg';

const crumbs = [{ label: 'Poêles à granulés', href: '/poele-a-granules/' }];
const description =
  'Poêles à granulés Palazzetti air, canalisables, gain de place ou hydro : vente et pose par un installateur RGE à Aire-sur-la-Lys, Ardres et Rexpoëde.';

const faqs: FaqItem[] = [
  {
    q: 'Quel poêle à granulés choisir pour ma maison ?',
    a: 'Un poêle à air convient pour chauffer une pièce de vie ouverte. Si vous voulez répartir la chaleur dans plusieurs pièces, un modèle canalisable est plus adapté. Pour chauffer toute la maison et produire de l’eau chaude, on s’oriente vers un poêle hydro. Nous dimensionnons l’appareil lors de l’étude gratuite.',
  },
  {
    q: 'Un poêle à granulés a-t-il besoin d’un conduit de cheminée ?',
    a: 'Il a besoin d’une évacuation des fumées, mais pas forcément d’une cheminée traditionnelle. Beaucoup de nos modèles sont étanches avec une sortie concentrique (ventouse), ce qui simplifie l’installation. Nous vérifions la solution la plus adaptée à votre logement.',
  },
  {
    q: 'Quel entretien pour un poêle à granulés ?',
    a: 'Un nettoyage simple et régulier du brasero et du cendrier par vos soins, et un entretien annuel obligatoire par un professionnel, avec le ramonage du conduit. Nous proposons l’entretien des appareils que nous installons.',
  },
  {
    q: 'Le poêle à granulés est-il éligible aux aides ?',
    a: 'Posé par un installateur RGE comme FK Énergie (QualiBois), un poêle performant peut ouvrir droit aux primes énergie (CEE) et à la TVA à taux réduit, selon votre situation. Depuis le 1er septembre 2026, MaPrimeRénov’ ne le finance plus seul, seulement dans le cadre d’une rénovation d’ampleur.',
  },
];
---

<BaseLayout
  title="Poêle à granulés Palazzetti : vente et pose RGE"
  ogImage={hero}
  description={description}
  breadcrumbs={crumbs}
  jsonLd={[
    serviceSchema({ name: 'Installation de poêles à granulés', description, path: '/poele-a-granules/', serviceType: 'Installation de poêle à granulés', brands: ['Palazzetti'] }),
    faqSchema(faqs),
  ]}
>
  <PageHero
    title="Poêles à granulés : le confort d’un chauffage automatique"
    lead="Programmable, économique et écologique : le poêle à granulés chauffe votre maison sans contrainte. Spécialistes Palazzetti depuis 2008, nous vous conseillons le modèle adapté et l’installons nous-mêmes."
    crumbs={crumbs}
    imageCaption="Palazzetti Anna Pro 3 · sept. 2026"
    image={hero}
    imageAlt="Poêle à granulés Palazzetti Anna Pro 3 installé par FK Énergie"
    rge={['qualibois']}
  />

  <section class="container-page grid gap-12 py-20 lg:grid-cols-12">
    <div class="prose-fk lg:col-span-7">
      <h2 class="!mt-0">Pourquoi choisir un poêle à granulés ?</h2>
      <p>
        Le granulé de bois (ou pellet) est l’une des énergies les plus économiques du marché. Alimenté automatiquement par son réservoir, votre poêle
        s’allume, régule et s’éteint seul, selon la programmation que vous avez choisie, et même à distance avec les modèles connectés.
      </p>
      <p>
        Nous travaillons principalement avec <strong>Palazzetti</strong>, fabricant italien reconnu pour la qualité de ses poêles : foyer et brasero en fonte,
        fonctionnement silencieux, possibilité de marche en convection naturelle, sans ventilateur. Nos techniciens sont formés sur toute la gamme.
      </p>
      <ul>
        <li><strong>Économique</strong> : un combustible bon marché et un rendement élevé.</li>
        <li><strong>Écologique</strong> : une énergie renouvelable, bien moins polluante que la combustion de bûches en foyer ouvert.</li>
        <li><strong>Automatique</strong> : allumage, régulation et extinction programmables.</li>
        <li><strong>Aidé</strong> : éligible aux aides lorsqu’il est posé par un installateur RGE.</li>
      </ul>
    </div>
    <div class="lg:col-span-5">
      <Image
        src={detail}
        alt="Poêle à granulés gain de place installé contre un mur en pierre"
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 460px, 100vw"
        class="aspect-[4/3] w-full rounded-3xl object-cover"
      />
      <div class="mt-6 rounded-3xl bg-ember-50 p-6 border border-ember-100">
        <p class="font-display text-lg font-bold">À voir en fonctionnement</p>
        <p class="mt-2 text-ink-600">
          Un système de poêle canalisable chauffe notre showroom d’Aire-sur-la-Lys : venez constater son efficacité.
        </p>
        <a href="/showrooms/aire-sur-la-lys/" class="mt-4 inline-flex items-center gap-2 font-display font-semibold text-ember-700">
          Voir le showroom <Icon name="arrow" class="size-4" />
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-20" aria-labelledby="types-title">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">Les technologies</p>
        <h2 id="types-title" class="mt-3 text-3xl sm:text-4xl">Quel type de poêle à granulés ?</h2>
        <p class="mt-4 text-lg text-ink-600">Chaque maison est différente. Voici les quatre grandes familles que nous installons.</p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <FeatureCard id="air" icon="flame" title="Poêle à granulés air" pros={['Installation simple', 'Idéal pour une pièce de vie ouverte', 'Convection forcée ou naturelle']} cons={['Chauffe principalement la pièce où il est installé']}>
          Le poêle diffuse sa chaleur dans la pièce par convection. Les modèles Palazzetti passent de la convection forcée (ventilée) à la
          convection naturelle, silencieuse.
        </FeatureCard>
        <FeatureCard id="canalisable" icon="home" title="Poêle à granulés canalisable" pros={['Chauffe plusieurs pièces', 'Jusqu’à 14 m de gaine par sortie (système Air Pro)', 'Ventilateurs pilotés indépendamment']} cons={['Pose plus technique']}>
          L’air chaud est acheminé par des gaines vers les chambres ou d’autres pièces : la solution pour chauffer une grande partie de la maison
          avec un seul appareil.
        </FeatureCard>
        <FeatureCard id="gain-de-place" icon="ruler" title="Poêle à granulés gain de place" pros={['Faible profondeur', 'Se glisse dans un couloir ou une petite pièce', 'Sortie des fumées arrière ou dessus']} cons={['Puissance plus limitée']}>
          Plat et compact, avec le réservoir et l’extracteur placés à côté du foyer, il se fait discret tout en chauffant efficacement.
        </FeatureCard>
        <FeatureCard id="hydro" icon="thermometer" title="Poêle à granulés hydro" pros={['Alimente vos radiateurs ou plancher chauffant', 'Peut produire l’eau chaude sanitaire', 'Grand réservoir']} cons={['Installation hydraulique à prévoir']}>
          Raccordé à votre circuit de chauffage central, le poêle hydro (ou bouilleur) fonctionne comme une chaudière tout en gardant la flamme
          visible dans votre salon.
        </FeatureCard>
      </div>
    </div>
  </section>

  <section class="container-page py-20" aria-labelledby="real-title">
    <div class="max-w-2xl">
      <p class="eyebrow">Nos poses</p>
      <h2 id="real-title" class="mt-3 text-3xl sm:text-4xl">Poêles à granulés installés par nos équipes</h2>
    </div>
    <div class="mt-10"><RealisationsGrid items={byCategory('granules').slice(0, 8)} /></div>
    <a href="/realisations/" class="btn-secondary mt-8">Voir toutes nos réalisations <Icon name="arrow" class="size-4" /></a>
  </section>

  <RelatedTools path="/poele-a-granules/" />
  <RelatedGuides path="/poele-a-granules/" />
  <Faq faqs={faqs} title="Vos questions sur les poêles à granulés" />
  <ServiceArea what="Poêles à granulés" />
  <CtaBand title="Votre poêle à granulés, posé par des pros RGE" />
</BaseLayout>
