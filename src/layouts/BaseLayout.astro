---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { organizationSchema, websiteSchema, breadcrumbSchema, webPageSchema, type Crumb, type PageType } from '../lib/schema';
// Polices du titre (LCP) et du texte : préchargées pour éviter le saut de mise en page.
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import figtreeUrl from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';

interface Props {
  /** Titre SEO (sans le nom de l'entreprise, ajouté automatiquement). */
  title: string;
  description: string;
  /** Image de partage : photo importée (recadrée en 1200 × 630) ou chemin servi depuis /public. */
  ogImage?: ImageMetadata | string;
  ogImageAlt?: string;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
  /** Titre complet, sans suffixe (page d'accueil, pages showroom). */
  fullTitle?: boolean;
  /** Type schema.org de la page (WebPage par défaut). */
  pageType?: PageType;
  /** Propriétés ajoutées au nœud WebPage (ex. liste d'images d'une galerie). */
  pageExtra?: Record<string, unknown>;
  /** og:type « article » pour les guides. */
  article?: { published: Date; modified?: Date; section?: string };
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  ogImageAlt = `${site.name}, installateur de poêles et pompes à chaleur`,
  noindex = false,
  breadcrumbs,
  jsonLd = [],
  fullTitle = false,
  pageType,
  pageExtra = {},
  article,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | FK Énergie`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const og =
  typeof ogImage === 'string'
    ? { src: ogImage, width: 1200, height: 630 }
    : await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 }).then((img) => ({
        src: img.src,
        width: Number(img.attributes.width ?? 1200),
        height: Number(img.attributes.height ?? 630),
      }));
const ogImageUrl = new URL(og.src, Astro.site).toString();

// Garde-fou : Google tronque au-delà d'environ 60 caractères (titre) et 160 (description).
if (!noindex && (pageTitle.length > 65 || description.length > 160)) {
  console.warn(`[seo] ${Astro.url.pathname} : titre ${pageTitle.length} car., description ${description.length} car. (max. 65 / 160)`);
}

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationSchema(),
    websiteSchema(),
    ...(noindex
      ? []
      : [
          { ...webPageSchema({ url: canonical, type: pageType, name: pageTitle, description, image: ogImageUrl, hasBreadcrumb: !!breadcrumbs?.length }), ...pageExtra },
          ...(breadcrumbs?.length ? [breadcrumbSchema(breadcrumbs, canonical)] : []),
        ]),
    ...jsonLd,
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F5EFE6" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:modified_time" content={(article.modified ?? article.published).toISOString()} />
          {article.section && <meta property="article:section" content={article.section} />}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="format-detection" content="telephone=no" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenu"
      class="sr-only z-50 rounded-full bg-ember-500 px-4 py-2 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Aller au contenu</a
    >
    <Header />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
