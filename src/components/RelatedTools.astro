---
import Icon from './Icon.astro';
import { outils, outilUrl } from '../data/outils';

interface Props {
  /** Page courante : affiche les outils qui la citent dans `related`. */
  path?: string;
  /** Outil à exclure (page d'un outil). */
  exclude?: string;
  title?: string;
}
const { path, exclude, title = 'Faites le calcul' } = Astro.props;
// Le simulateur (outil vedette) est en tête de liste et ressort sur fond sombre
const list = outils.filter((o) => o.slug !== exclude && (!path || o.related.includes(path)));
const lien = (o: (typeof outils)[number]) => (o.vedette ? `${outilUrl(o)}simulateur/` : outilUrl(o));
---

{
  list.length > 0 && (
    <section class="container-page py-16" aria-labelledby="outils-title">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">outils gratuits</p>
          <h2 id="outils-title" class="mt-2 text-3xl sm:text-4xl">{title}</h2>
        </div>
        <a href="/outils/" class="link-arrow">Tous nos outils <Icon name="arrow" class="size-4" /></a>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {list.map((o) => (
          <li class:list={[o.vedette && 'sm:col-span-2 lg:col-span-3']}>
            {o.vedette ? (
              <a href={lien(o)} class="group flex h-full flex-wrap items-center gap-x-5 gap-y-3 rounded-3xl bg-ink-900 p-6 text-ink-200 transition hover:shadow-xl hover:shadow-ink-900/20 sm:p-7">
                <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-ember-600 text-white">
                  <Icon name={o.icon} class="size-7" />
                </span>
                <span class="flex min-w-0 flex-1 basis-64 flex-col gap-1">
                  <span class="font-display text-2xl leading-snug font-semibold text-white">{o.name}</span>
                  <span>{o.question} Dessinez votre maison pour le voir.</span>
                </span>
                <span class="inline-flex items-center gap-2 rounded-full bg-ember-600 px-5 py-3 font-bold text-white transition group-hover:bg-ember-700">
                  Ouvrir le simulateur <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
                </span>
              </a>
            ) : (
              <a href={lien(o)} class="group flex h-full items-start gap-4 rounded-3xl border border-ink-200 bg-white p-5 transition hover:border-ember-300 hover:shadow-xl hover:shadow-ink-900/5">
                <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-ember-100 text-ember-800 transition group-hover:bg-ember-600 group-hover:text-white">
                  <Icon name={o.icon} class="size-6" />
                </span>
                <span class="flex flex-col gap-1">
                  <span class="font-display text-xl leading-snug font-semibold text-ink-900 group-hover:text-ember-700">{o.name}</span>
                  <span class="text-ink-600">{o.question}</span>
                </span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}
