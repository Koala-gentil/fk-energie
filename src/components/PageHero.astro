---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import type { Crumb } from '../lib/schema';
import { site } from '../data/site';

interface Props {
  /** Petite note manuscrite au-dessus du titre. */
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** Légende manuscrite posée sur la photo (ex. « Posé à Licques, février 2026 »). */
  imageCaption?: string;
  cta?: boolean;
  imageAspect?: 'portrait' | 'landscape';
}

const nbsp = (t?: string) => t?.replace(/ ([:;!?»])/g, '\u202f$1').replace(/« /g, '«\u202f');
const { eyebrow, title: rawTitle, lead: rawLead, crumbs = [], image, imageAlt = '', imageCaption, cta = true, imageAspect = 'portrait' } = Astro.props;
const title = nbsp(rawTitle)!;
const lead = nbsp(rawLead);
---

<section class="border-b border-ink-200">
  <div class:list={['container-page grid items-center gap-10 py-12 lg:py-16', image && 'lg:grid-cols-12 lg:gap-14']}>
    <div class:list={['flex flex-col gap-5', image ? 'lg:col-span-7' : 'max-w-3xl']}>
      {
        crumbs.length > 0 && (
          <nav aria-label="Fil d’Ariane" class="text-sm text-ink-600">
            <ol class="flex flex-wrap items-center gap-1.5">
              <li>
                <a href="/" class="hover:text-ember-700">Accueil</a>
              </li>
              {crumbs.map((c, i) => (
                <li class="flex items-center gap-1.5">
                  <span aria-hidden="true" class="text-ink-400">/</span>
                  {i === crumbs.length - 1 ? (
                    <span aria-current="page" class="font-semibold text-ink-900">{c.label}</span>
                  ) : (
                    <a href={c.href} class="hover:text-ember-700">{c.label}</a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      {eyebrow && <p class="eyebrow -rotate-1">{eyebrow}</p>}
      <h1 class="text-4xl leading-[1.04] sm:text-5xl lg:text-6xl">{title}</h1>
      {lead && <p class="max-w-2xl text-lg leading-relaxed text-ink-700 sm:text-xl">{lead}</p>}
      <slot />
      {
        cta && (
          <div class="mt-2 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href="/contact/" class="btn-primary">
              Demander une étude gratuite
            </a>
            <a href={site.phoneHref} class="link-arrow">
              <Icon name="phone" class="size-5 text-ember-600" /> {site.phone}
            </a>
          </div>
        )
      }
    </div>
    {
      image && (
        <figure class="relative lg:col-span-5">
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 460px, 92vw"
            class:list={[
              'w-full rounded-[1.75rem] object-cover shadow-xl shadow-ink-900/10',
              imageAspect === 'portrait' ? 'aspect-[4/5] lg:max-h-[560px]' : 'aspect-[4/3]',
            ]}
            loading="eager"
            fetchpriority="high"
          />
          {imageCaption && (
            <figcaption class="absolute -bottom-4 left-4 -rotate-2 rounded-lg bg-white px-4 py-2 font-hand text-2xl text-ink-900 shadow-lg shadow-ink-900/10">
              {imageCaption}
            </figcaption>
          )}
        </figure>
      )
    }
  </div>
</section>
