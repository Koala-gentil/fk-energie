---
interface Props {
  sources: { label: string; url: string }[];
  note?: string;
}
const { sources, note = 'La réglementation et les aides évoluent : en cas de doute, référez-vous aux textes officiels ou demandez-nous conseil.' } = Astro.props;
---

<section class="container-page pb-8" aria-labelledby="sources-title">
  <div class="rounded-3xl border border-ink-200 bg-white p-6 sm:p-8">
    <h2 id="sources-title" class="text-2xl">Sources</h2>
    <ol class="mt-4 list-decimal space-y-2 pl-6 text-ink-700 marker:text-ink-500">
      {
        sources.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener" class="underline decoration-ink-300 underline-offset-2 hover:text-ember-700">{s.label}</a>
          </li>
        ))
      }
    </ol>
    <p class="mt-4 text-sm text-ink-600">{note}</p>
  </div>
</section>
