---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  title = 'Parlons de votre projet',
  text = 'Étude et devis gratuits, chez vous ou dans l’un de nos trois showrooms.',
  ctaLabel = 'Demander une étude',
  ctaHref = '/contact/',
} = Astro.props;
---

<section class="container-page py-16">
  <div class="flex flex-col gap-6 rounded-[2rem] bg-ember-100 px-6 py-10 sm:px-10 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-col gap-2">
      <h2 class="text-3xl sm:text-4xl">{title}</h2>
      <p class="text-lg text-ink-700">{text}</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href={ctaHref} class="btn-primary">{ctaLabel}</a>
      <a href={site.phoneHref} class="link-arrow"><Icon name="phone" class="size-5 text-ember-600" /> {site.phone}</a>
    </div>
  </div>
</section>
