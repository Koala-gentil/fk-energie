---
import { openingHours, formatSlot } from '../data/site';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<dl class:list={['divide-y divide-ink-200', className]}>
  {
    openingHours.map((h) => (
      <div class="flex justify-between gap-4 py-2.5">
        <dt class="font-semibold text-ink-900">{h.days}</dt>
        <dd class="text-right text-ink-600">{h.slots.length ? h.slots.map(formatSlot).join(' · ') : 'Fermé'}</dd>
      </div>
    ))
  }
</dl>
