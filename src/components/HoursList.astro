---
import { openingHours, showrooms, formatSlot, type OpeningHours } from '../data/site';
interface Props {
  class?: string;
  /** Horaires d'un showroom (`showroomHours`), sinon les horaires communs. */
  hours?: OpeningHours[];
}
const { class: className = '', hours } = Astro.props;
// Horaires communs : on signale les showrooms qui s'en écartent (« Rexpoëde : fermé le lundi »).
const notes = hours ? [] : showrooms.filter((s) => s.hoursNote).map((s) => `${s.city} : ${s.hoursNote}.`);
---

<dl class:list={['divide-y divide-ink-200', className]}>
  {
    (hours ?? openingHours).map((h) => (
      <div class="flex justify-between gap-4 py-2.5">
        <dt class="font-semibold text-ink-900">{h.days}</dt>
        <dd class="text-right text-ink-600">{h.slots.length ? h.slots.map(formatSlot).join(' · ') : 'Fermé'}</dd>
      </div>
    ))
  }
</dl>
{notes.length > 0 && <p class="mt-3 text-sm text-ink-500">{notes.join(' ')}</p>}
