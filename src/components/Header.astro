---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import { site, productNav, serviceNav, mainNav } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const desktopNav = [
  { label: 'Poêles à granulés', href: '/poele-a-granules/' },
  { label: 'Poêles à bois', href: '/poele-a-bois/' },
  { label: 'Pompes à chaleur', href: '/pompes-a-chaleur/' },
  { label: 'Chaudières', href: '/chaudieres/' },
  { label: 'Nos poses', href: '/realisations/' },
  { label: 'Showrooms', href: '/showrooms/' },
];
---

<div class="bg-ink-100 text-sm text-ink-700">
  <div class="container-page flex min-h-10 flex-wrap items-center justify-between gap-x-4 gap-y-1 py-1.5">
    <p class="flex items-center gap-2">
      <span class="hidden sm:inline">Nos 3 showrooms :</span>
      <OpenStatus class="!bg-transparent !px-0 !py-0" />
    </p>
    <a href={site.phoneHref} class="flex items-center gap-1.5 font-bold text-ink-900 hover:text-ember-700">
      <Icon name="phone" class="size-4 text-ember-600" />
      {site.phone}
    </a>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-ink-200 bg-ink-50/95 backdrop-blur supports-[backdrop-filter]:bg-ink-50/85">
  <div class="container-page flex h-20 items-center justify-between gap-6">
    <a href="/" class="shrink-0 text-[26px]" aria-label="FK Énergie, retour à l’accueil">
      <Logo />
    </a>

    <nav aria-label="Navigation principale" class="hidden xl:block">
      <ul class="flex items-center gap-1 text-[15px] font-semibold">
        {
          desktopNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="rounded-full px-3.5 py-2 text-ink-800 transition hover:bg-ink-100 aria-[current=page]:text-ember-700 aria-[current=page]:underline aria-[current=page]:decoration-ember-400 aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/contact/" class="btn-primary hidden min-h-11 px-5 py-2.5 text-[15px] sm:inline-flex">Demander une étude</a>
      <button
        type="button"
        class="grid size-11 place-items-center rounded-full bg-ink-100 text-ink-900 hover:bg-ink-200 xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Ouvrir le menu"
        data-mobile-toggle
      >
        <Icon name="menu" class="size-6" data-icon-open />
        <Icon name="close" class="hidden size-6" data-icon-close />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden max-h-[calc(100dvh-5rem)] overflow-y-auto border-t border-ink-200 bg-ink-50 xl:hidden" data-mobile-menu>
    <nav aria-label="Navigation mobile" class="container-page grid gap-8 py-6 md:grid-cols-2">
      <ul>
        {
          productNav.map((item) => (
            <li>
              <a href={item.href} class="flex min-h-12 items-center border-b border-ink-200 font-display text-xl font-semibold text-ink-900 hover:text-ember-700">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul>
        {
          [...serviceNav, ...mainNav, { label: 'Contact', href: '/contact/' }].map((item) => (
            <li>
              <a href={item.href} class="flex min-h-12 items-center border-b border-ink-200 font-display text-xl font-semibold text-ink-900 hover:text-ember-700">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="grid gap-2 sm:grid-cols-2 md:col-span-2">
        <a href={site.phoneHref} class="btn-secondary"><Icon name="phone" class="size-5 text-ember-600" /> {site.phone}</a>
        <a href="/contact/" class="btn-primary">Demander une étude</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    menu?.classList.toggle('hidden', !open);
    toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    document.body.classList.toggle('overflow-hidden', open);
  });
</script>
