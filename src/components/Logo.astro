---
/**
 * Logo officiel FK Énergie (fichier fourni par l'entreprise, octobre 2026), sans la ligne de slogan.
 * - tone « dark » : pour les fonds clairs (version d'origine, « Energie » en gris anthracite)
 * - tone « light » : pour les fonds sombres (« Energie » et l'arc supérieur passés en blanc)
 * Sources : src/assets/brand/, recadrées depuis le PNG d'origine (2001 × 751 px).
 */
import { Image } from 'astro:assets';
import logoClair from '../assets/brand/logo-fond-clair.png';
import logoSombre from '../assets/brand/logo-fond-sombre.png';

interface Props {
  tone?: 'dark' | 'light';
  /** Hauteur du logo, en classe Tailwind (ex. « h-14 »). */
  class?: string;
  eager?: boolean;
  /** Largeur affichée (attribut sizes), à garder cohérente avec la hauteur : largeur = hauteur × 3,85. */
  sizes?: string;
}
const { tone = 'dark', class: className = 'h-14', eager = false, sizes = '216px' } = Astro.props;
const src = tone === 'light' ? logoSombre : logoClair;
---

<Image
  src={src}
  alt="FK Énergie"
  widths={[120, 160, 240, 320, 480]}
  {sizes}
  class:list={['w-auto', className]}
  loading={eager ? 'eager' : 'lazy'}
/>
