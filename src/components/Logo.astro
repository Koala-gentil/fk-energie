---
/**
 * Logo officiel FK Énergie (photo de profil 2026), détouré sur fond transparent.
 * - tone « dark » : pour les fonds clairs (texte « NERGIE » en encre)
 * - tone « light » : pour les fonds sombres (texte blanc, version d'origine)
 * Sources : src/assets/brand/, générées depuis assets/raw/facebook/profil_01.jpg.
 */
import { Image } from 'astro:assets';
import logoClair from '../assets/brand/logo-fond-clair.png';
import logoSombre from '../assets/brand/logo-fond-sombre.png';

interface Props {
  tone?: 'dark' | 'light';
  /** Hauteur du logo, en classe Tailwind (ex. « h-14 »). */
  class?: string;
  eager?: boolean;
  /** Largeur affichée (attribut sizes), à garder cohérente avec la hauteur : largeur = hauteur × 1,46. */
  sizes?: string;
}
const { tone = 'dark', class: className = 'h-14', eager = false, sizes = '120px' } = Astro.props;
const src = tone === 'light' ? logoSombre : logoClair;
---

<Image
  src={src}
  alt="FK Énergie"
  widths={[90, 140, 180, 240, 360]}
  {sizes}
  class:list={['w-auto', className]}
  loading={eager ? 'eager' : 'lazy'}
/>
