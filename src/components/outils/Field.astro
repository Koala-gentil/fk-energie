---
/** Champ numérique d'un outil de calcul, avec son unité. */
interface Props {
  name: string;
  label: string;
  value: number;
  unit: string;
  min?: number;
  max?: number;
  step?: number | 'any';
  hint?: string;
  id?: string;
  class?: string;
}
const { name, label, value, unit, min = 0, max, step = 1, hint, id = name, class: className } = Astro.props;
---

<div class={className}>
  <label for={id} class="mb-2 block font-bold">{label}</label>
  <div class="flex h-13 items-center rounded-xl border border-ink-300 bg-white transition focus-within:border-ember-600 focus-within:ring-4 focus-within:ring-ember-600/15">
    <input
      id={id}
      name={name}
      type="number"
      inputmode="decimal"
      value={value}
      min={min}
      max={max}
      step={step}
      required
      aria-describedby={hint ? `${id}-hint` : undefined}
      class="h-full min-w-0 flex-1 rounded-xl bg-transparent px-4 text-lg font-semibold text-ink-900 focus:outline-none"
    />
    {unit && <span class="pr-4 font-semibold text-ink-500">{unit}</span>}
  </div>
  {hint && <p id={`${id}-hint`} class="mt-1.5 text-sm text-ink-600">{hint}</p>}
</div>
